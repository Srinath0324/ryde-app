# Audited placeholder templates stay public (never insert real credentials).
!/env.template
!/android/app/google-services.template.json
!/lib/firebase_options.template.dart

# SELECTIVE PUBLIC SHOWCASE: retain UI, assets, generic map/location services,
# authentication, history, models, and build scaffolding. Exclude core business
# logic below. These rules do NOT untrack files or remove earlier commits.
# A public checkout is intentionally incomplete and is not a runnable app.

# Ride dispatch, matching, pricing, negotiation, tracking, and wallet logic
/lib/services/active_ride_service.dart
/lib/services/city_detection_service.dart
/lib/services/driver_response_service.dart
/lib/services/dynamic_fare_service.dart
/lib/services/fare_config_setup_service.dart
/lib/services/fcm_service.dart
/lib/services/negotiation_service.dart
/lib/services/real_time_tracking_service.dart
/lib/services/ride_request_service.dart
/lib/services/smart_driver_filtering_service.dart
/lib/services/wallet_service.dart

# State coordination for the private ride workflows
/lib/providers/driver_response_provider.dart
/lib/providers/dynamic_fare_provider.dart
/lib/providers/ride_provider.dart
/lib/providers/wallet_provider.dart

# Screens that contain substantial workflow logic alongside their UI
/lib/screens/user_to_driver_matching_screen.dart
/lib/screens/negotiation_screen.dart
/lib/screens/tracking_screen.dart

# Internal ride, driver-state, pricing, and negotiation contracts
/lib/models/driver_response_model.dart
/lib/models/driver_status_model.dart
/lib/models/fare_config_model.dart
/lib/models/negotiation_model.dart
/lib/models/negotiation_offer_model.dart
/lib/models/ride_request_model.dart

# Detailed implementation documents also describe the excluded internals.
/docs/RYDE_USER_PROJECT_DOCUMENTATION.md
/docs/RYDE_USER_PROJECT_DOCUMENTATION.pdf

.cursor/